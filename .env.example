# ==============================================================================
# SES ANALİZİ PLATFORMU - ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & GÜVENLİK YAPILANDIRMASI
# ------------------------------------------------------------------------------
# APP_ENV: Ortam türü ('development' veya 'production'). Üretimde API_KEY ve WEBHOOK_SECRET zorunludur.
APP_ENV=development
API_KEY=my_secure_api_key_12345
WEBHOOK_SECRET=my_webhook_secret_key_67890
RATE_LIMIT_PER_MINUTE=5000 # toplu feedback entegrasyonu için yüksek tutulmalı

# ------------------------------------------------------------------------------
# 2. VERİTABANI YAPILANDIRMASI
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///storage/dev_database.db
ALLOW_SQLITE_FALLBACK=false

# ------------------------------------------------------------------------------
# 3. ASENKRON KUYRUK VE FİZİKSEL DEPOLAMA YAPILANDIRMASI
# ------------------------------------------------------------------------------
USE_REDIS_STREAM=true
USE_REDIS_QUEUE=false
REDIS_URL=redis://localhost:6379/0

STORAGE_TYPE=disk
STORAGE_DIR=storage/raw
MEMORY_STORAGE_MAX_BYTES=536870912

# ------------------------------------------------------------------------------
# 4. ÇEVRİMDİŞİ YAPAY ZEKA VE MODEL YAPILANDIRMASI (%100 TOKEN-FREE)
# ------------------------------------------------------------------------------
MODEL_DIR=storage/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

DIARIZATION_ENGINE=sherpa_onnx
DIARIZATION_ESCALATION=off
WHISPER_MODEL_SIZE=medium
WHISPER_BEAM_SIZE=1
WORKER_CPU_THREADS=4
DIARIZATION_STEP_SEC=0.5
DIARIZATION_THRESHOLD=0.80
# TARGET_NUM_SPEAKERS: Belirtilmezse (boş/yorumda) otomotik threshold-based konuşmacı sayısı tespiti çalışır.
TARGET_NUM_SPEAKERS=2
MAX_SILENCE_THRESHOLD=1.5
ENABLE_DENOISER=false

# ------------------------------------------------------------------------------
# 5. ANLAMSAL DÜZELTME & YEREL LLM (OLLAMA) YAPILANDIRMASI
# ------------------------------------------------------------------------------
DOMAIN_MODE=
USE_LLM=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 6. OTOMATİK VERİ SAKLAMA VE SİLME SÜRELERİ (RETENTION CONFIG - 0 = KALICI SAKLAMA)
# ------------------------------------------------------------------------------
AUDIO_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 7. SWEEPER & HATA KURTARMA GARANTİ HİZMETİ (DLQ)
# ------------------------------------------------------------------------------
SWEEPER_INTERVAL_SEC=30
PENDING_STALE_SEC=300
PROCESSING_STALE_SEC=1800
MAX_JOB_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 8. S3 / BULUT DEPOLAMA DETAYLARI (STORAGE_TYPE=s3 DURUMUNDA)
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=ses-analizi-storage
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
